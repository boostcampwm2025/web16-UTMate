# Node Environment
NODE_ENV=development

# Database
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=utmate
DATABASE_PASSWORD=utmate
DATABASE_NAME=utmate

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Server
SERVER_PORT=8080
SDK_DOMAIN=your-sdk-domain.com
CLIENT_URL=http://localhost:3000

# Client
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_INTERNAL_API_URL=http://localhost:8080/api
NEXT_PUBLIC_GA_ID=G-12341234
NEXT_MSW_ENABLED=false
NEXT_PUBLIC_SDK_DOMAIN=http://localhost:80/sdk/utmate-sdk.iife.js

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8080/api/auth/github/callback

# JWT
JWT_ACCESS_SECRET=your-super-secret-key-change-this-in-production
JWT_ACCESS_EXPIRES_IN=1800
JWT_REFRESH_SECRET=your-super-secret-key-change-this-in-production-for-refresh
JWT_REFRESH_EXPIRES_IN=604800

# S3
S3_ACCESS_KEY_ID=your_aws_access_key_id
S3_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_REGION=your_aws_region
S3_BUCKET_NAME=your_s3_bucket_name
S3_ENDPOINT=optional_custom_endpoint_url