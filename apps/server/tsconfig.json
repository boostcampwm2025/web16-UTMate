{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "#common/*": ["src/common/*"],
      "#domain/*": ["src/domain/*"]
    }
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      "experimentalDecorators": true, // 데코레이터 허용 (핵심)
      "emitDecoratorMetadata": true, // 메타데이터 허용 (핵심)
      "strictPropertyInitialization": false // 초기값 없는 변수 에러 무시 (id: number 에러 해결)
    }
  }
}
