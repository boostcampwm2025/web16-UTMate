{
  "name": "sdk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "prettier": "@org/prettier-config",
  "files": [
    "dist"
  ],
  "main": "./dist/my-sdk.umd.cjs",
  "module": "./dist/my-sdk.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/my-sdk.js",
      "require": "./dist/my-sdk.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "check": "pnpm format:check && pnpm lint"
  },
  "devDependencies": {
    "@org/eslint-config": "workspace:*",
    "@org/prettier-config": "workspace:*",
    "@rushstack/eslint-config": "^3.6.8",
    "@rushstack/eslint-patch": "^1.10.1",
    "eslint": "^8.57.0",
    "prettier": "^3",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-dts": "^4.5.4"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.5"
    }
  }
}
