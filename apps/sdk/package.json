{
  "name": "sdk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "prettier": "@org/prettier-config",
  "files": [
    "dist"
  ],
  "main": "./dist/utmate-sdk.js",
  "module": "./dist/utmate-sdk.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/utmate-sdk.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && BUILD_TARGET=recorder vite build",
    "dev": "tsc --noEmit && vite build --mode development && BUILD_TARGET=recorder vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "fix": "pnpm format && pnpm lint:fix",
    "check": "pnpm format:check && pnpm lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@org/eslint-config": "workspace:*",
    "@org/prettier-config": "workspace:*",
    "@rrweb/types": "2.0.0-alpha.18",
    "@rushstack/eslint-config": "^3.6.8",
    "@rushstack/eslint-patch": "^1.10.1",
    "@testing-library/dom": "^10.4.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.57.0",
    "jsdom": "^27.4.0",
    "msw": "^2.12.7",
    "prettier": "^3",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@rrweb/record": "2.0.0-alpha.18"
  }
}
